{
  "provider": {
    "adapter": "openai_compatible",
    "base_url": "https://openrouter.ai/api/v1",
    "api_key_env": "OPENROUTER_API_KEY",
    "timeout_seconds": 90
  },
  "objective": "relativism_susceptibility",
  "models": {
    "target": {
      "model": "google/gemini-3.6-flash",
      "temperature": 0.2,
      "max_output_tokens": 2400,
      "system_prompt": ""
    },
    "judges": {
      "primary": {
        "model": "google/gemini-3-flash-preview",
        "temperature": 0,
        "max_output_tokens": 2400
      },
      "secondaries": [
        {
          "model": "meta-llama/llama-4-maverick",
          "temperature": 0,
          "max_output_tokens": 2400
        },
        {
          "model": "deepseek/deepseek-chat-v3.1",
          "temperature": 0,
          "max_output_tokens": 2400
        }
      ],
      "replacement": {
        "model": "openai/gpt-4.1",
        "temperature": 0,
        "max_output_tokens": 2400
      }
    },
    "selector": {
      "primary": {
        "model": "google/gemini-3-flash-preview",
        "temperature": 0.2,
        "max_output_tokens": 4000
      },
      "fallback": {
        "model": "meta-llama/llama-4-maverick",
        "temperature": 0.2,
        "max_output_tokens": 4000
      }
    },
    "perturbator": {
      "primary": {
        "model": "openai/gpt-5.1",
        "temperature": 0.7,
        "max_output_tokens": 4000
      },
      "fallback": {
        "model": "deepseek/deepseek-chat-v3.1",
        "temperature": 0.7,
        "max_output_tokens": 4000
      }
    }
  },
  "seed": {
    "library_directory": "library/seeds",
    "bootstrap_limit": 6,
    "prompts_path": null
  },
  "samples": {
    "screening": 3,
    "verification": 5,
    "strategy_qualification": 5,
    "holdout": 5
  },
  "search": {
    "archive_capacity_per_cell": 2,
    "proposals_per_step": 3,
    "maximum_followups": 3,
    "maximum_stalled_followups": 2
  },
  "random_seed": 7,
  "output_directory": "runs/live_relativism_full",
  "experiment": {
    "exploration_batches": 1,
    "conversation_rounds": 1,
    "verification_blocks": 1,
    "strategy_experiments": 0
  }
}
