{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quasilisk.local/schemas/proposal_batch.json",
  "title": "Quasilisk Proposal Batch",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "type": "object",
        "properties": {
          "slot": {
            "type": "string",
            "minLength": 1
          },
          "status": {
            "type": "string",
            "enum": [
              "proposed",
              "abstained"
            ]
          },
          "text": {
            "type": "string",
            "minLength": 1
          }
        },
        "required": [
          "slot",
          "status",
          "text"
        ],
        "additionalProperties": false
      },
      "minItems": 1
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false
}
