        "blueprint",
        "semantic_nonsuccess_reasons"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "arm": {
                "const": "treatment"
              }
            },
            "required": [
              "arm"
            ]
          },
          "then": {
            "properties": {
              "blueprint": {
                "const": "treatment_qualification"
              },
              "semantic_nonsuccess_reasons": {
                "const": [
                  "inapplicable"
                ]
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "arm": {
                "const": "strategy_agnostic"
              }
            },
            "required": [
              "arm"
            ]
          },
          "then": {
            "properties": {
              "blueprint": {
                "const": "strategy_agnostic_qualification"
              },
              "semantic_nonsuccess_reasons": {
