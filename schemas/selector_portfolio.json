{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://quasilisk.local/schemas/selector_portfolio.json",
  "title": "Quasilisk Selector Portfolio",
  "type": "object",
  "properties": {
    "items": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/PortfolioItem"
      },
      "minItems": 0
    }
  },
  "required": [
    "items"
  ],
  "additionalProperties": false,
  "$defs": {
    "BasisItem": {
      "type": "object",
      "properties": {
        "use": {
          "type": "string",
          "enum": [
            "continuation_anchor",
            "recovery_anchor",
            "corroboration",
            "judge_concern",
            "presentation_signal"
          ]
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "reading": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "use",
        "evidence_id",
        "reading"
      ],
      "additionalProperties": false
    },
    "StrategyTarget": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "claim",
            "premise",
            "inference",
            "conflict",
            "preference",
            "condition",
            "commitment",
            "application",
            "other"
          ]
        },
        "evidence_id": {
          "type": "string",
          "minLength": 1
        },
        "summary": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "kind",
        "evidence_id",
        "summary"
      ],
      "additionalProperties": false
    },
    "StrategyMove": {
      "type": "object",
      "properties": {
        "target": {
          "$ref": "#/$defs/StrategyTarget"
        },
        "descriptors": {
          "$ref": "#/$defs/StrategyDescriptorObject"
        },
        "blueprint": {
          "type": "string",
          "minLength": 1
        },
        "operation": {
          "$ref": "#/$defs/StrategyOperation"
        }
      },
      "required": [
        "operation",
        "target",
        "descriptors",
        "blueprint"
      ],
      "additionalProperties": false
    },
    "PreserveItem": {
      "type": "object",
      "properties": {
        "kind": {
          "type": "string",
          "enum": [
            "premise",
            "commitment",
            "scope",
            "meaning",
            "branch_fact"
          ]
        },
        "statement": {
          "type": "string",
          "minLength": 1
        },
        "evidence_id": {
          "anyOf": [
            {
              "type": "string",
              "minLength": 1
            },
            {
              "type": "null"
            }
          ]
        }
      },
      "required": [
        "kind",
        "statement",
        "evidence_id"
      ],
      "additionalProperties": false
    },
    "VariationInstruction": {
      "type": "object",
      "properties": {
        "dimension": {
          "type": "string",
          "enum": [
            "wording",
            "tone_register",
            "framing",
            "structure",
            "directness",
            "specificity",
            "example_analogy",
            "premise_order",
            "question_form",
            "supporting_material"
          ]
        },
        "instruction": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "dimension",
        "instruction"
      ],
      "additionalProperties": false
    },
    "SuccessTransition": {
      "type": "object",
      "properties": {
        "from": {
          "type": "string",
          "minLength": 1
        },
        "to": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "from",
        "to"
      ],
      "additionalProperties": false
    },
    "StrategySuccess": {
      "type": "object",
      "properties": {
        "transition": {
          "$ref": "#/$defs/SuccessTransition"
        },
        "supports": {
          "type": "string",
          "minLength": 1
        },
        "falsifies": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "transition",
        "supports",
        "falsifies"
      ],
      "additionalProperties": false
    },
    "BoundStrategy": {
      "type": "object",
      "properties": {
        "basis": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/BasisItem"
          },
          "minItems": 1
        },
        "move": {
          "$ref": "#/$defs/StrategyMove"
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "preserve": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/PreserveItem"
          },
          "minItems": 1
        },
        "vary": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/VariationInstruction"
          },
          "minItems": 1
        },
        "success": {
          "$ref": "#/$defs/StrategySuccess"
        }
      },
      "required": [
        "basis",
        "move",
        "hypothesis",
        "preserve",
        "vary",
        "success"
      ],
      "additionalProperties": false
    },
    "DiagnosisCategory": {
      "type": "string",
      "enum": [
        "other"
      ]
    },
    "DiagnosisEvidence": {
      "type": "object",
      "properties": {
        "evidence_id": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "evidence_id"
      ],
      "additionalProperties": false
    },
    "SelectorDiagnosis": {
      "type": "object",
      "properties": {
        "category": {
          "$ref": "#/$defs/DiagnosisCategory"
        },
        "summary": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/DiagnosisEvidence"
          },
          "minItems": 1,
          "maxItems": 3
        }
      },
      "required": [
        "category",
        "summary",
        "evidence"
      ],
      "additionalProperties": false
    },
    "PortfolioItem": {
      "type": "object",
      "properties": {
        "diagnosis": {
          "$ref": "#/$defs/SelectorDiagnosis"
        },
        "contract": {
          "$ref": "#/$defs/BoundStrategy"
        },
        "applicability": {
          "type": "object",
          "properties": {
            "requires": {
              "type": "string",
              "minLength": 1
            },
            "excludes": {
              "type": "string",
              "minLength": 1
            }
          },
          "required": [
            "requires",
            "excludes"
          ],
          "additionalProperties": false
        }
      },
      "required": [
        "diagnosis",
        "contract",
        "applicability"
      ],
      "additionalProperties": false
    },
    "StrategyDescriptorObject": {
      "type": "object",
      "properties": {},
      "required": [],
      "additionalProperties": false
    },
    "StrategyOperation": {
      "type": "string",
      "enum": [
        "complete_opening"
      ]
    }
  }
}
